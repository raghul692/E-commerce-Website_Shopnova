# SHOPNOVA Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Prisma defaults to SQLite file for dev zero-config, PostgreSQL ready)
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET=shopnova_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=shopnova_refresh_secret_key_2026

# Payment Gateway Keys (Razorpay & Stripe Integration Architecture)
RAZORPAY_KEY_ID=rzp_test_shopnova_key_id
RAZORPAY_KEY_SECRET=rzp_test_shopnova_secret_key
STRIPE_SECRET_KEY=sk_test_shopnova_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_shopnova_stripe_webhook_secret

# OAuth Config (Google & GitHub Drivers)
GOOGLE_CLIENT_ID=google_oauth_client_id_placeholder
GOOGLE_CLIENT_SECRET=google_oauth_client_secret_placeholder

# Storage & Redis Config
STORAGE_DRIVER=local # local | s3
REDIS_URL=redis://localhost:6379
